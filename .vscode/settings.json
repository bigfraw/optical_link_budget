{
  // Markdown All in One (yzhang.markdown-all-in-one): keep the auto-maintained
  // "## Contents" TOCs in docs/api-*.md in the shape they were generated in.
  // Levels 2..3, GitHub-style anchors (also render in the VS Code preview and
  // on GitHub), updated on every save.
  "markdown.extension.toc.levels": "2..3",
  "markdown.extension.toc.slugifyMode": "github",
  "markdown.extension.toc.updateOnSave": true
}
